{
    "name": "dubwise",
    "private": true,
    "type": "module",
    "description": "Dev tooling only. The app itself has no dependencies.",
    "scripts": {
        "test": "node --test \"tests/*.test.mjs\"",
        "check": "tsc -p . && biome check .",
        "check:browser": "node tests/browser/audio.mjs && node tests/browser/ui.mjs",
        "check:offline": "node tests/browser/offline.mjs",
        "sw:version": "node tools/sw-version.mjs",
        "check:ai": "node tests/browser/ai-model.mjs",
        "build:lexicon": "node tools/build-lexicon.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "node-web-audio-api": "2.2.0",
        "typescript": "7.0.2"
    }
}
